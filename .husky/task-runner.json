{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "check-first-party-content",
      "group": "pre-commit",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "scripts/check.ps1", "content"],
      "include": [
        "**/*.md",
        "**/*.json",
        "**/*.jsonc",
        "**/*.yml",
        "**/*.yaml",
        "**/*.css",
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.sh",
        ".husky/pre-commit",
        ".editorconfig",
        ".prettierignore",
        ".lychee*.toml"
      ]
    },
    {
      "name": "dotnet-format-staged",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "format",
        "opengamebuilder.slnx",
        "--include",
        "${staged}",
        "--verbosity",
        "minimal"
      ],
      "include": ["**/*.cs"]
    }
  ]
}
