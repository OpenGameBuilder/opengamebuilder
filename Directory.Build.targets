<Project>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Audit the resolved graph, including tests/AppHost and transitive packages.
         Preserve the existing all-severity NuGet warning-as-error policy. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- NuGet can create an absent lock even in locked mode; CI must require it. -->
  <Target Name="RequireCommittedNuGetLockFile" BeforeTargets="Restore;CollectPackageReferences"
          Condition="'$(RestoreLockedMode)' == 'true' and '$(RestorePackagesWithLockFile)' == 'true'">
    <PropertyGroup>
      <_RequiredNuGetLockFile Condition="'$(NuGetLockFilePath)' == ''">packages.lock.json</_RequiredNuGetLockFile>
      <_RequiredNuGetLockFile Condition="'$(NuGetLockFilePath)' != ''">$(NuGetLockFilePath)</_RequiredNuGetLockFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(_RequiredNuGetLockFile)')"
           Text="Missing dependency lockfile '$(_RequiredNuGetLockFile)' for $(MSBuildProjectName). Restore the committed file, or refresh and review lockfiles using docs/setup/development.md." />
  </Target>

</Project>
