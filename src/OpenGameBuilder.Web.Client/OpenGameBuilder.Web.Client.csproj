<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!--
      Allow MapStaticAssets to substitute fingerprinted asset paths (e.g. css/app.css)
      directly inside wwwroot/index.html at publish time. Required because the standalone
      WASM host serves index.html as a static asset rather than rendering it through Razor.
    -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <!--
    Standalone Blazor WebAssembly environment selection (.NET 10+).
    Keep Development local to Debug. Release always uses Production so a single published
    artifact works in staging, production, forks, and alternate hostnames. The browser uses
    its current origin for API requests; no deployment hostname is compiled into the client.
  -->
  <PropertyGroup Condition="'$(WasmApplicationEnvironmentName)' == '' AND '$(Configuration)' == 'Debug'">
    <WasmApplicationEnvironmentName>Development</WasmApplicationEnvironmentName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WasmApplicationEnvironmentName>Production</WasmApplicationEnvironmentName>
  </PropertyGroup>

  <!-- Do not package the local API override (or list it in the WASM boot manifest). -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="wwwroot/appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenGameBuilder.Api.Client\OpenGameBuilder.Api.Client.csproj" />
  </ItemGroup>

</Project>
