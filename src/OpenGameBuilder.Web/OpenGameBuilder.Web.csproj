<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!--
      Allow MapStaticAssets to substitute fingerprinted asset paths (e.g. css/app.css)
      directly inside wwwroot/index.html at publish time. Required because the standalone
      WASM host serves index.html as a static asset rather than rendering it through Razor.
    -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

</Project>
